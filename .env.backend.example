# Server-only settings. Never prefix these with VITE_ or place them in .env.local.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
SUPABASE_SECRET_KEY=sb_secret_your-project-secret-key
# Optional legacy fallback; SUPABASE_SECRET_KEY takes precedence when both are set.
# SUPABASE_SERVICE_ROLE_KEY=your-legacy-service-role-jwt
RESUME_OCR_ENABLED=false
SCREENING_WORKER_CONCURRENCY=1
SCREENING_POLL_INTERVAL=2s
BACKEND_ADDR=:8080

# Resend transactional email. Leave EMAIL_PROVIDER unset until owner setup is complete.
EMAIL_PROVIDER=
EMAIL_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=ProofHire
